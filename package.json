{
  "name": "dsh-admin",
  "version": "0.2.0",
  "description": "面向局域网（Docker 部署）的多租户 DSH 托管平台：登录审核、每用户隔离的 DSH 环境（主 + 按需守护）、共享模型配置。",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./runtime": "./lib/runtime.js"
  },
  "bin": {
    "dsh-admin": "./lib/cli.js"
  },
  "files": [
    "lib",
    "web",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "dev": "node lib/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dsh": {
    "plugin": true,
    "kind": "server",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "disclosure": {
    "cloud": true,
    "network": [
      "https://api.deepseek.com"
    ],
    "permissions": {
      "filesystem": "per-user-0700",
      "network": "egress",
      "env": "read-listed"
    },
    "jurisdiction": [
      "PIPL(CN)"
    ],
    "retention": "server"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/static": "^10.1.3",
    "archiver": "^8.0.0",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.0.0",
    "tar": "^7.5.22",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/tar": "^6.1.13",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pointer-a/dsh-admin.git"
  },
  "license": "MIT"
}
